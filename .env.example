# Copy this file to `.env` and fill in your provider credentials.
# `.env` is gitignored and will not be committed.

# Required. Your provider API key.
MICROCODE_API_KEY=

# API base URL. Protocol is inferred from this value:
#   URLs containing "anthropic" -> Anthropic Messages API
#   everything else            -> OpenAI Chat Completions
#
# DeepSeek Anthropic: https://api.deepseek.com/anthropic
# DeepSeek OpenAI:    https://api.deepseek.com/v1
# OpenAI:             https://api.openai.com/v1
# OpenRouter:         https://openrouter.ai/api/v1
MICROCODE_BASE_URL=https://api.deepseek.com/anthropic

# Model id as the provider expects it.
# DeepSeek: deepseek-v4-pro  or  deepseek-v4-flash
# OpenAI:   gpt-4o-mini
MICROCODE_MODEL=deepseek-v4-pro

# Optional. Force protocol instead of inferring from the URL: auto | anthropic | openai
# MICROCODE_API_PROTOCOL=auto

# Optional. Max generated tokens per model call.
# MICROCODE_MAX_TOKENS=8192
